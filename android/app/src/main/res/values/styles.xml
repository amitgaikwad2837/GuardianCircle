<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. React Native renders its own UI; this controls
         the system chrome (status bar, navigation bar, splash screen). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Edge-to-edge layout — React Native SafeAreaProvider handles insets -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Splash screen theme — shown before JS bundle loads -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
