{
  "name": "GuardianCircle",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox test --configuration android.emu.debug",
    "test:e2e:release": "detox test --configuration android.emu.release",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "clean": "react-native clean",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.4",
    "@op-engineering/op-sqlite": "^8.0.2",
    "@react-native-firebase/app": "^20.5.0",
    "@react-native-firebase/messaging": "^20.5.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.56.2",
    "date-fns": "^3.6.0",
    "eventemitter3": "^5.0.1",
    "libphonenumber-js": "^1.11.7",
    "react": "18.3.1",
    "react-native": "0.75.4",
    "react-native-background-timer": "^2.4.1",
    "react-native-device-info": "^11.1.0",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "2.20.2",
    "react-native-haptic-feedback": "^2.3.1",
    "react-native-keychain": "^8.2.0",
    "react-native-mmkv": "2.12.2",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-permissions": "^4.1.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "3.34.0",
    "react-native-svg": "^15.6.0",
    "react-native-vision-camera": "^5.0.11",
    "uuid": "^11.0.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/runtime": "^7.25.6",
    "@react-native/babel-preset": "0.75.4",
    "@react-native/eslint-config": "0.75.4",
    "@react-native/metro-config": "0.75.4",
    "@react-native/typescript-config": "0.75.4",
    "@testing-library/react-native": "^14.0.0",
    "@types/react": "^18.3.6",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "detox": "^20.26.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/e2e/"
    ],
    "moduleNameMapper": {
      "^@core/sms/SmsService$": "<rootDir>/src/core/sms/SMSService",
      "^@core/(.*)$": "<rootDir>/src/core/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@app/(.*)$": "<rootDir>/src/app/$1",
      "^@assets/(.*)$": "<rootDir>/src/assets/$1"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-reanimated|react-native-gesture-handler|react-native-screens|react-native-safe-area-context|react-native-mmkv|react-native-keychain|react-native-permissions|react-native-haptic-feedback|@notifee|uuid|@op-engineering|eventemitter3)/)"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 10,
        "functions": 8,
        "lines": 10,
        "statements": 10
      }
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/index.ts",
      "!src/**/*.stories.tsx"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
